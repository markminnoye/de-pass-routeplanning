TOMTOM_API_KEY=

# Verplicht: de schooldag waarop departAt vastligt (YYYY-MM-DD, geen weekend).
# Zonder vaste datum vervalt de TomTom-cache dagelijks en zijn scenario's niet
# vergelijkbaar. Kan ook per run met --reference-date.
BUSROUTES_REFERENCE_DATE=

# Kostenmatrix achter ordering "auto": matrix (default, TomTom-reistijden, ~1500
# transacties per nieuw scenario) of haversine (gratis, maar 4-13% langere ritten).
BUSROUTES_ORDERING=matrix

# historical (default, reproduceerbaar) of live.
BUSROUTES_TRAFFIC=historical

# Waar TomTom-antwoorden bewaard blijven. Default: .cache/tomtom in deze repo.
# Zet dit naar een map die je sessies overleeft — weggooien = alles opnieuw betalen.
BUSROUTES_CACHE_DIR=
